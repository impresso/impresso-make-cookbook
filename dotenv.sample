# Save this file as .env or make sure that your environment knows them!
# Credentials for accessing impresso s3
SE_ACCESS_KEY=<YOUR VALUE>
SE_SECRET_KEY=<YOUR VALUE>
SE_HOST=<YOUR VALUE>

# create python venv inside the project (.venv); make uses it automatically
PIPENV_VENV_IN_PROJECT=enabled

# to set the cookbook's logging to DEBUG for troubleshooting
#LOGGING_LEVEL=DEBUG

# For repositories that need a java runtime, e.g. mallet LDA
#JAVA_HOME=<YOUR VALUE>
